# Copy thành .env rồi điền giá trị (file này KHÔNG bắt buộc nữa)

# Xác thực Claude cho tính năng Chat/AI — chọn MỘT trong hai cách:
#   Cách 1 (khuyên dùng, không cần điền gì): đăng nhập Claude Code trên máy này
#     (VSCode extension hoặc lệnh `claude` -> /login) — hệ thống tự dùng gói subscription.
#   Cách 2: điền API key (tính phí theo usage, lấy tại https://console.anthropic.com/settings/keys)
# ANTHROPIC_API_KEY=

# Tạo ảnh Gemini (bắt buộc cho Images Project + ảnh minh họa): lấy tại aistudio.google.com/apikey
GEMINI_API_KEY=

# Số job render song song 1-4 (override tab Cấu hình)
QUEUE_CONCURRENCY=

# Ports (mặc định đã đúng, chỉ đổi khi bị trùng)
SERVER_PORT=6869
